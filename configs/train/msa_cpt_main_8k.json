{
  "run": {
    "name": "msa-cpt-main-8k",
    "seed": 42,
    "output_dir": "outputs/train/msa-cpt-main-8k"
  },
  "model": {
    "model_path": "outputs/train/msa-cpt-warmup-8k/last",
    "trust_remote_code": false,
    "torch_dtype": "bfloat16",
    "attn_implementation": "flash_attention_2"
  },
  "data": {
    "train_jsonl": "converted_training_data/msa_pretrain_conservative.jsonl",
    "validation_jsonl": "converted_training_data/msa_pretrain_valid.jsonl",
    "max_train_samples": null,
    "max_eval_samples": null,
    "shuffle": true,
    "num_workers": 4
  },
  "sequence": {
    "max_seq_len": 8192,
    "max_documents_per_sample": 24,
    "max_document_tokens": 256,
    "max_query_tokens": 256,
    "max_answer_tokens": 32,
    "packing": false
  },
  "optimization": {
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "learning_rate": 0.000006,
    "weight_decay": 0.0,
    "max_steps": 10000,
    "warmup_steps": 200,
    "lr_scheduler_type": "cosine",
    "gradient_checkpointing": true,
    "max_grad_norm": 1.0
  },
  "losses": {
    "lm_loss_weight": 1.0,
    "aux_loss_weight": 0.1,
    "answer_loss_weight": 0.0,
    "reconstruction_loss_weight": 0.0
  },
  "checkpointing": {
    "save_steps": 500,
    "save_total_limit": 5,
    "resume_from_checkpoint": null
  },
  "logging": {
    "logging_steps": 10,
    "report_to": []
  }
}
